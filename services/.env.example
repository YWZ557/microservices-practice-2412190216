# 复制为 services/.env 后填写；.env 已被 services/.gitignore 忽略
TZ=Asia/Shanghai

# MySQL（宿主机端口冲突时改 MYSQL_PORT，例如 3308）
MYSQL_ROOT_PASSWORD=root123456
MYSQL_PORT=3307

# Nacos 3 鉴权：TOKEN 必须是 base64 编码且解码后 >= 32 字节
NACOS_AUTH_TOKEN=<base64-encoded-secret-32-bytes-min>
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=<random-identity-value>
NACOS_PASSWORD=123456

# 宿主机端口
NACOS_CONSOLE_PORT=18080
NACOS_SERVER_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_GRPC_SERVER_PORT=9849
USER_SERVICE_PORT=8081
BORROW_SERVICE_PORT=8083
GATEWAY_PORT=8080
