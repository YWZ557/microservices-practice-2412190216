<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zjgsu.zyw.mapper.BookMapper">
    <select id="list" resultType="com.zjgsu.zyw.enity.Book">
        select * from book where id = #{id}
    </select>
    <update id="setStatusById">
        update book set status = #{status} where id = #{id};
    </update>
    <select id="getBook" resultType="com.zjgsu.zyw.enity.Book">
        select * from book
        <where>
            <if test="title != null and title != ''">and title like concat('%',#{title},'%')</if>
            <if test="category != null and category != ''">and category like concat('%',#{category},'%')</if>
            <if test="bookId != null">and book_id = #{bookId}</if>
            <if test="status != null">and status = #{status}</if>
        </where>
    </select>
    <insert id="create">
        insert into book
        <set>
            <if test="isbn != null">isbn = #{isbn},</if>
            <if test="title != null">title = #{title},</if>
            <if test="author != null">author = #{author},</if>
            <if test="publisher != null">publisher = #{publisher},</if>
            <if test="category != null">category = #{category},</if>
            <if test="status != null">status = #{status},</if>
            <if test="location != null">location = #{location},</if>
        </set>
    </insert>
    <delete id="deleteById">
        delete from book where id = #{id}
    </delete>
    <update id="updateById">
        update book
        <set>
            <if test="isbn != null">isbn = #{isbn},</if>
            <if test="title != null">title = #{title},</if>
            <if test="author != null">author = #{author},</if>
            <if test="publisher != null">publisher = #{publisher},</if>
            <if test="category != null">category = #{category},</if>
            <if test="status != null">status = #{status},</if>
            <if test="location != null">location = #{location},</if>
        </set>
        where id = #{id}
    </update>
</mapper>
