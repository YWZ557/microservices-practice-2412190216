# 复制为 .env 后填写真实值；.env 已在 .gitignore 中，不要提交
# Nacos 鉴权 Token 必须为 base64，解码后长度 >= 32 字节

# ---------- Nacos 鉴权 ----------
NACOS_AUTH_TOKEN=<base64-secret-32-bytes-min>
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=<random-identity-value>
NACOS_AUTH_TOKEN_EXPIRE_SECONDS=18000

# ---------- Nacos 控制台管理员（首次访问控制台时设置） ----------
NACOS_USERNAME=nacos
NACOS_PASSWORD=<your-admin-password>

# ---------- MySQL 容器 ----------
MYSQL_ROOT_PASSWORD=<mysql-root-password>
# 宿主机映射端口，本机 3307 已被占用时保持 3308
MYSQL_PORT=3308
