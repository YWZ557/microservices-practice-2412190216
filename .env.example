# ============================================================
# 图书馆借阅系统 · 环境变量模板（第 05 周）
# ------------------------------------------------------------
# 用法：
#   1. 复制模板：cp .env.example .env   （Windows: copy .env.example .env）
#   2. 按需修改密码等参数
#   3. 启动：docker compose up -d --build
# ------------------------------------------------------------
# 注意：.env 含有真实密码，不要提交到 Git；本文件仅为可公开的模板。
# 所有变量在 compose.yaml 中都有默认值，因此不建 .env 也能直接启动。
# ============================================================

# ---------------- 应用 ----------------
# 宿主机映射端口（浏览器访问 http://localhost:8080）
APP_PORT=8080
# 构建出的镜像名与标签
IMAGE_NAME=monolith
IMAGE_TAG=week05
# 容器时区
TZ=Asia/Shanghai

# ---------------- MySQL ----------------
# 业务数据库名，应用启动时由 data.sql 建表
MYSQL_DATABASE=library
# root 密码（mysql 镜像必填），仅用于运维/客户端排查
MYSQL_ROOT_PASSWORD=root123456
# 业务账号，应用通过该账号连接（对 MYSQL_DATABASE 拥有全部权限）
MYSQL_USER=libuser
MYSQL_PASSWORD=lib123456
# 宿主机映射端口；本机已安装 MySQL 占用 3306 时改为 3307
MYSQL_PORT=3306

# ---------------- 数据持久化 ----------------
# 数据卷由 compose.yaml 固定命名为 library-mysql-data，
# 因此无需在此声明；重建容器时不要执行 docker compose down -v，
# 否则数据卷会被删除、数据随之丢失。
